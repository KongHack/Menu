{
    "name": "gcworld/menu",
    "description": "GCWorld Industries Menu Builder",
    "authors": [
        {
            "name": "GameCharmer",
            "email": "admin@gamecharmer.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.15"
    },
    "license":"proprietary",
    "autoload": {
        "psr-4": {
            "GCWorld\\Menu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GCWorld\\Menu\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@phpstan",
            "@test"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    }
}
