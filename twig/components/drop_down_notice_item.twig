<li class="notification-li{% if hover_text is not empty %} tool_button{% endif %}"{% if hover_text is not empty %} title="{{ hover_text|e('html') }}"{% endif %}><a class="notification-entry {{ class|raw }}" href="{{ url|raw }}"{% for key, value in data %} data-{{ key|raw }}="{{ value|e('html') }}"{% endfor %}><span class="notification-icon">{{ icon|raw }}</span><span class="notification-message">{{ message|raw }}</span></a></li>
