<p>{% if panel_loader is null %}<a href="{{ url|raw }}" class="btn btn-{{ class|raw }} btn-block{% if not ajaxy %} no-ajaxy{% endif %}"{% if click is not empty %} onclick="{{ click|raw }}"{% endif %}{% if new_window %} target="_blank"{% endif %}>{% else %}<a class="btn btn-{{ class|raw }} btn-block no-ajaxy" onclick="$('.{{ panel_class|raw }}:not(#MENU_{{ panel_loader|raw }})').fadeOut('fast', function(){$('#MENU_{{ panel_loader|raw }}').fadeIn('fast');}); return false;">{% endif %}{{ name|raw }}</a></p>
